# 复制本文件为 .streamlit/secrets.toml 并填入你的配置。
# secrets.toml 已被 .gitignore 忽略，不会提交到仓库。

# 种子账号密码：首次启动生成种子数据时读取；不配置则自动生成随机密码并打印到终端。
ADMIN_PASSWORD = "在这里填写管理员密码"
DEMO_PASSWORD = "在这里填写演示用户统一密码"

# 可选：托管 PostgreSQL 连接串（如 Supabase）。配置后改用 PostgreSQL 持久化；
# 不配置则使用本地 SQLite（data/guatfood.db）。本地部署到 Streamlit Cloud 时建议配置此项，
# 否则线上数据会因临时文件系统在重启后丢失。
#
# 重要：Supabase 的「直连」地址 db.<ref>.supabase.co 只解析 IPv6，部分网络不稳定。
# 请用 Dashboard → Settings → Database → Connection string 里的
# 「Session pooler」(端口 5432，IPv4) 那条，用户名是 postgres.<ref>：
# DATABASE_URL = "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
